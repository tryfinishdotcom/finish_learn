// .env.example
# Server
PORT=3000
NODE_ENV=production

# Database (provided by Railway)
DATABASE_URL=postgresql://user:password@host:port/database

# Memberstack
MEMBERSTACK_SECRET_KEY=your_secret_key_here
MEMBERSTACK_PUBLIC_KEY=pk_46d89c86f1c449e5d013
# Optional: audience check; defaults to this site's Memberstack app id
# MEMBERSTACK_APP_ID=app_cmde998dl011d0wx92d1xae1y
# Temporary, client cutover only: until this UTC time (e.g. 2026-10-24T18:00Z, at most
# 7 days ahead) a bare member id is still admitted as the learner. Unset (the default)
# means only verified Memberstack tokens are accepted.
# AUTH_MEMBER_ID_FALLBACK_UNTIL=
# Local development only (needs NODE_ENV=development, ignored on Railway): 'true'
# takes the learner id from X-Member-ID / the bearer without verification.
# AUTH_DEV_BYPASS=

# Sentry
SENTRY_DSN=your_sentry_dsn_here

# CORS
ALLOWED_ORIGINS=https://your-site.webflow.io,https://your-custom-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
