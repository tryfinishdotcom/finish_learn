// .env.example
# Server
PORT=3000
NODE_ENV=production

# Database (provided by Railway)
DATABASE_URL=postgresql://user:password@host:port/database

# Memberstack
MEMBERSTACK_SECRET_KEY=your_secret_key_here
MEMBERSTACK_PUBLIC_KEY=pk_46d89c86f1c449e5d013

# Sentry
SENTRY_DSN=your_sentry_dsn_here

# CORS
ALLOWED_ORIGINS=https://your-site.webflow.io,https://your-custom-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SKIP_AUTH=false
